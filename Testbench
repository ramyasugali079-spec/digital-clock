`timescale 1ns/1ps

module tb_digital_clock;

    reg clk;
    reg reset;

    wire [4:0] hours;
    wire [5:0] minutes;
    wire [5:0] seconds;

    // Instantiate digital clock
    // CLK_FREQ = 2 for fast simulation
    digital_clock #(
        .CLK_FREQ(2)
    ) DUT (
        .clk(clk),
        .reset(reset),
        .hours(hours),
        .minutes(minutes),
        .seconds(seconds)
    );

    // 10 ns clock period
    always #5 clk = ~clk;

    initial begin

        // Generate waveform
        $dumpfile("digital_clock.vcd");
        $dumpvars(0, tb_digital_clock);

        // Initialize
        clk   = 1'b0;
        reset = 1'b1;

        // Reset clock
        #12;

        reset = 1'b0;

        // Run simulation
        #1300;

        $finish;

    end

    // Display clock value
    always @(posedge clk) begin
        $display(
            "Time=%0t ns | %02d:%02d:%02d",
            $time,
            hours,
            minutes,
            seconds
        );
    end

endmodule
